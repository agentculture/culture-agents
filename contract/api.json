      "stream": false,
      "content_type": "application/json",
      "params": {
        "run_id": "common.json#/$defs/run_id"
      },
      "query": {},
      "errors": [
        "invalid",
        "incompatible_version",
        "internal",
        "not_found",
        "unsupported"
      ]
    },
    {
      "id": "runs.answer",
      "method": "POST",
      "path": "/v1/runs/{run_id}/answer",
      "summary": "Answer one pending question of a run. Refused with unsupported, capability answer, when the run's harness cannot ask.",
      "cli": "agents runs answer",
      "d1": "unsupported",
      "request": "control-action.json#/$defs/answer_request",
      "response": "control-action.json#/$defs/accepted_response",
      "status": 202,
      "stream": false,
      "content_type": "application/json",
      "params": {
        "run_id": "common.json#/$defs/run_id"
      },
      "query": {},
      "errors": [
        "invalid",
        "incompatible_version",
        "internal",
        "not_found",
        "unsupported",
        "conflict",
        "unavailable"
      ]
    },
    {
      "id": "branches.list",
      "method": "GET",
      "path": "/v1/branches",
      "summary": "Every runs branch of one repository with its run's state and the git evidence of whether its commits are reachable from another ref.",
      "cli": "agents branches list",
      "d1": "supported",
      "request": null,
      "response": "branches.json",
      "status": 200,
      "stream": false,
      "content_type": "application/json",
      "params": {},
      "query": {
        "repo": {
          "$ref": "common.json#/$defs/repo_path"
        }
      },
      "errors": [
        "invalid",
        "incompatible_version",
        "internal",
        "denied"
      ]
    },
    {
      "id": "branches.remove",
      "method": "POST",
      "path": "/v1/branches/remove",
      "summary": "Delete the finished runs branches of one repository that git shows reachable from another ref, with git branch -d only; skip and report the rest.",
      "cli": "agents branches remove",
      "d1": "supported",
      "request": "branches.json#/$defs/remove_request",
      "response": "branches.json#/$defs/remove_response",
      "status": 200,
      "stream": false,
      "content_type": "application/json",
      "params": {},
      "query": {},
      "errors": [
        "invalid",
        "incompatible_version",
        "internal",
        "denied"
      ]
    },
    {
      "id": "fleet.members",
      "method": "GET",
      "path": "/v1/fleet/members",
      "summary": "The fleet members this core heard announce themselves, and the announcements it refused (added in 3.1). With the fleet transport off, both lists are empty.",
      "cli": "agents agents list",
      "d1": "supported",
      "request": null,
      "response": "fleet.json",
      "status": 200,
      "stream": false,
      "content_type": "application/json",
      "params": {},
      "query": {},
      "errors": [
        "invalid",
        "incompatible_version",
        "internal"
      ]
    },
