    {
      "id": "fleet.aliases",
      "method": "GET",
      "path": "/v1/fleet/aliases",
      "summary": "The aliases a fleet member defines and what its allow-list permits on each, read from it over the fleet transport (added in 3.2).",
      "cli": "agents agents aliases",
      "d1": "supported",
      "request": null,
      "response": "remote.json#/$defs/alias_list",
      "status": 200,
