      "method": "POST",
      "path": "/v1/fleet/runs/{run_id}/cancel",
      "summary": "Cancel a run on another member, over the fleet transport (added in 3.2).",
      "cli": "agents runs cancel (remote run)",
      "d1": "supported",
      "request": "control-action.json#/$defs/cancel_request",
      "response": "control-action.json#/$defs/accepted_response",
      "status": 202,
      "stream": false,
      "content_type": "application/json",
      "params": {
