{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://culture.dev/contract/agents/error.json",
  "title": "Error response",
  "description": "Body of every non-2xx response. HTTP status, CLI exit code and retryability per code are fixed in api.json `errors` and README.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "code": {
      "enum": [
        "invalid",
        "denied",
        "not_found",
        "busy",
        "conflict",
        "unsupported",
        "incompatible_version",
        "unavailable",
        "internal"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "message": {
          "description": "One human-readable sentence; for environment errors it includes a remediation hint.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "capability": {
          "description": "unsupported only: the capability that was refused.",
          "$ref": "capabilities.json#/$defs/capability_name"
        },
        "field": {
          "description": "invalid only (optional): JSON Pointer to the offending request field, or a query/path parameter name.",
          "type": "string",
          "maxLength": 200
        },
        "run_id": {
          "description": "The run the error concerns, when there is one. Required for conflict.",
          "$ref": "common.json#/$defs/run_id"
        },
        "active_run_id": {
          "description": "busy only: the active run holding the repository.",
          "$ref": "common.json#/$defs/run_id"
        },
        "repo": {
          "description": "busy only: the canonical repository path that is busy.",
          "$ref": "common.json#/$defs/repo_path"
        },
        "client_api_version": {
          "$ref": "common.json#/$defs/api_version"
        },
        "server_api_version": {
          "$ref": "common.json#/$defs/api_version"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "unsupported"
              }
            }
          },
          "then": {
            "required": [
              "capability"
            ],
            "properties": {
              "retryable": {
                "const": false
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "capability"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "busy"
              }
            }
          },
          "then": {
            "required": [
              "active_run_id",
              "repo"
            ],
            "properties": {
              "retryable": {
                "const": true
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "active_run_id"
                  ]
                },
                {
                  "required": [
                    "repo"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "incompatible_version"
              }
            }
          },
          "then": {
            "required": [
              "client_api_version",
              "server_api_version"
            ],
            "properties": {
              "retryable": {
                "const": false
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "client_api_version"
                  ]
                },
                {
                  "required": [
                    "server_api_version"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "invalid"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "field"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "required": [
              "run_id"
            ]
          }
        },
        {
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "enum": [
                  "invalid",
                  "denied",
                  "not_found",
                  "internal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
