{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://culture.dev/contract/agents/run.json",
  "title": "Run",
  "description": "One submitted unit of work executed by one agent through one harness. State is authoritative only as read from the run's on-disk event log or its live worker (README: state machine, restart).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "agent_id",
    "session_id",
    "harness",
    "repo",
    "task",
    "owner",
    "idempotency_key",
    "deadline",
    "state",
    "state_reason",
    "terminal",
    "created_at",
    "updated_at",
    "started_at",
    "ended_at",
    "cursor",
    "live_control",
    "worker_pid",
    "branch"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/run_id"
    },
    "agent_id": {
      "$ref": "common.json#/$defs/mesh_id"
    },
    "session_id": {
      "$ref": "common.json#/$defs/session_id"
    },
    "harness": {
      "$ref": "common.json#/$defs/harness_id"
    },
    "repo": {
      "$ref": "common.json#/$defs/repo_path"
    },
    "task": {
      "$ref": "common.json#/$defs/text"
    },
    "base_commit": {
      "description": "The commit of `repo` the run starts from, resolved by the core when the submit was accepted. Absent only on a run recorded before the core set it (README: authorization).",
      "$ref": "common.json#/$defs/git_sha"
    },
    "owner": {
      "description": "The principal named by the submit request's `caller`, recorded as supplied and not authenticated. See `submitter` for what the core established.",
      "$ref": "common.json#/$defs/principal"
    },
    "submitter": {
      "description": "Who submitted the run, as the core established it and never from a request field. Absent only on a run recorded before the core set it (README: authorization).",
      "$ref": "#/$defs/submitter"
    },
    "idempotency_key": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/idempotency_key"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadline": {
      "$ref": "common.json#/$defs/nullable_timestamp"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "state_reason": {
      "description": "Human-readable reason for the current state, or null.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "terminal": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "started_at": {
      "description": "When the harness session started; null until the run first enters `running`.",
      "$ref": "common.json#/$defs/nullable_timestamp"
    },
    "ended_at": {
      "$ref": "common.json#/$defs/nullable_timestamp"
    },
    "cursor": {
      "description": "Cursor of the newest event in the run's event log.",
      "$ref": "common.json#/$defs/cursor"
    },
    "pending_questions": {
      "description": "Questions the run has asked its operator that have no answer yet, oldest first, read from the run's event log. Empty when it is waiting for nothing. Absent when the core does not report questions.",
      "type": "array",
      "items": {
        "$ref": "event.json#/$defs/question"
      }
    },
    "live_control": {
      "description": "True when this core can deliver steer, cancel and answer to the run's worker. False for every terminal run, and for a run whose worker this core has not reattached to.",
      "type": "boolean"
    },
    "worker_pid": {
      "description": "PID of the run's worker process, or null once no worker is known.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "branch": {
      "description": "Host branch holding the run's commits, `runs/<run_id>`, or null when there are none yet. At most 132 characters: `runs/` and a run id of at most 127.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 132,
      "pattern": "^runs/[a-z0-9]{1,32}-[a-z0-9_]+(-[a-z0-9_]+)*\\.run\\.[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "extension": {
      "$ref": "common.json#/$defs/extension"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "$ref": "#/$defs/terminal_state"
          }
        }
      },
      "then": {
        "properties": {
          "terminal": {
            "const": true
          },
          "live_control": {
            "const": false
          },
          "ended_at": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "pending_questions": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "terminal": {
            "const": false
          },
          "ended_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "started_at": {
            "$ref": "common.json#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "queued"
          }
        }
      },
      "then": {
        "properties": {
          "started_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "state": {
      "description": "Run state. Legal transitions are in api.json `state_machine` and README.",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "unknown",
        "unanswered"
      ]
    },
    "active_state": {
      "enum": [
        "queued",
        "running",
        "cancelling"
      ]
    },
    "terminal_state": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "unknown",
        "unanswered"
      ],
      "description": "A final state. `unanswered`: a question the run asked its operator passed its own time limit. `unknown`: the outcome cannot be established; it is never a success."
    },
    "submitter": {
      "description": "Who submitted a run, as the core established it. `local_user`: the request arrived on the core's own control socket, and `uid` is the operating-system user that owns that socket. `member`: the request arrived from another core, and `node` is the fleet member the connection authenticated as, `key` (3.3) the fingerprint of the key it authenticated with. No request field sets or changes it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local_user",
            "member"
          ]
        },
        "uid": {
          "description": "local_user only: the numeric id of the user that owns the control socket.",
          "type": "integer",
          "minimum": 0
        },
        "user": {
          "description": "local_user only (optional): that user's account name, when the core could resolve it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "node": {
          "description": "member only: the node name of the authenticated fleet member.",
          "$ref": "common.json#/$defs/node"
        },
        "key": {
          "description": "member only (3.3, optional): the SHA-256 fingerprint, hex, of the public key the member authenticated with at submit. A member acts on a run only with this key (a node name moved to another key does not inherit its runs); a run without it is matched by node.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "local_user"
              }
            }
          },
          "then": {
            "required": [
              "uid"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "node"
                  ]
                },
                {
                  "required": [
                    "key"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "member"
              }
            }
          },
          "then": {
            "required": [
              "node"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "uid"
                  ]
                },
                {
                  "required": [
                    "user"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "run_list": {
      "description": "Response of GET /v1/runs: newest first by created_at.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    "run_result": {
      "description": "Response of GET /v1/runs/{run_id}/result; only served for a terminal run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "state",
        "summary",
        "branch",
        "commits",
        "ended_at",
        "error"
      ],
      "properties": {
        "run_id": {
          "$ref": "common.json#/$defs/run_id"
        },
        "state": {
          "$ref": "#/$defs/terminal_state"
        },
        "summary": {
          "description": "The harness's final assistant text, or null if it produced none.",
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "$ref": "#/properties/branch"
        },
        "commits": {
          "description": "Commits on `branch`, oldest first. Empty when there are none.",
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/git_sha"
          }
        },
        "ended_at": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "error": {
          "oneOf": [
            {
              "$ref": "error.json#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "error.json#/$defs/error"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
