{
  "name": "@culture.dev/agents",
  "version": "0.15.3",
  "description": "TypeScript core of the culture-agents control plane",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "culture-agents-core": "dist/src/daemon/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/contract-schemas",
    "policy",
    "image"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/copy-contract-schemas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-timeout=120000 'dist/test/**/*.test.js'",
    "test:coverage": "npm run build && node --test --test-timeout=120000 --experimental-test-coverage --enable-source-maps --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov 'dist/test/**/*.test.js'",
    "gen:contract": "node scripts/gen-contract-types.mjs",
    "check:contract-types": "node scripts/gen-contract-types.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "dependencies": {
    "@ai-openshell/sdk": "0.1.10",
    "@ai-sdk/harness": "1.0.192",
    "@ai-sdk/harness-claude-code": "1.0.196",
    "ajv": "8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentculture/culture-agents.git",
    "directory": "core"
  },
  "homepage": "https://github.com/agentculture/culture-agents#readme"
}
